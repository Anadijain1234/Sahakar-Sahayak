# ==============================================================================
# Sahakar Sahayak - Environment Configuration (.env.example)
# ==============================================================================

# Application Environment (development, test, production)
ENV=development

# ------------------------------------------------------------------------------
# 1. Database & Security
# ------------------------------------------------------------------------------
# SQLite default database path or PostgreSQL / MySQL connection string
DATABASE_URL=sqlite:///backend/data/sahakar_sahayak.db

# Secret key used for signing JWT authentication tokens (Change in production!)
JWT_SECRET=sahakar-sahayak-production-auth-key-secret-2026

# ------------------------------------------------------------------------------
# 2. Email Verification Service (SMTP)
# ------------------------------------------------------------------------------
# If left blank, the application will safely simulate email delivery and print
# the OTP verification code directly to the backend console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@sahakarsahayak.gov.in
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 3. SMS Verification Service
# ------------------------------------------------------------------------------
# Option A: Twilio SMS Gateway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option B: Generic HTTP SMS Gateway (Fast2SMS, MSG91, etc.)
SMS_GATEWAY_URL=
SMS_API_KEY=

# If neither Twilio nor a Gateway URL is set, the application will safely
# simulate SMS delivery and print the phone OTP code directly to the backend console.

# ------------------------------------------------------------------------------
# 4. AI & NLP Assistant (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key for intelligent cooperative guidance
SARVAM_API_KEY=

# Sarvam AI API key for Indian language voice / speech engines (Optional)
SARVAM_API_KEY=

# Telegram Bot Token for cooperative query bot (Optional)
TELEGRAM_BOT_TOKEN=
