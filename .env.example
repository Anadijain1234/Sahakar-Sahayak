# ==============================================================================
# Sahakar Sahayak - environment variables (.env.example)
# Copy to .env for local development. On Render, set these in Environment.
# NEVER commit real keys.
# ==============================================================================

# --- AI (answers, question rewriting, speech-to-text) ---
SARVAM_API_KEY=

# --- Backup AI #1 (free key: console.groq.com) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_JUDGE_MODEL=openai/gpt-oss-20b   (benchmark judge only)

# --- Meaning search + backup AI #2 (Cloudflare Workers AI) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- AI fallback settings (optional) ---
# LLM_ORDER=sarvam,groq,cloudflare
# LLM_TIMEOUT=30
# LLM_COOLDOWN=60

# --- Bhashini speech (Government of India language platform) ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- Live AI check on every answer (optional; default on, with safe daily limits) ---
# LIVE_JUDGE=on
# LIVE_JUDGE_GROQ_DAILY=120
# LIVE_JUDGE_CLOUDFLARE_DAILY=80

# --- Admin Insights password (website /admin, or backend /insights?key=...) ---
INSIGHTS_KEY=

# --- Login security ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Email OTP (Brevo) ---  empty = OTP printed to the backend console
EMAIL_API_KEY=
SENDER_EMAIL=

# --- Phone OTP (SMS gateway app) ---  empty = OTP printed to the backend console
GATEWAY_API_KEY=

# --- Permanent database: user accounts + admin insights (free Neon Postgres: neon.com) ---
# Paste Neon's connection string, e.g. postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Empty = SQLite file in backend/data (wiped on every Render redeploy)
DATABASE_URL=

# --- Public backend address used in PDF source links ---
PUBLIC_BACKEND_URL=https://sahakar-sahayak-4.onrender.com

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
API_URL=https://sahakar-sahayak-4.onrender.com/query

# --- Frontend (Vite) ---
VITE_API_URL=https://sahakar-sahayak-4.onrender.com
